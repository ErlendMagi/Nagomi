:"まもら","w":1814},{"s":"れ","w":58},{"s":"た","w":8},{"s":"ん","w":26},{"s":"です","w":17},{"s":"ね","w":51},{"s":"。"}]},{"speaker":"hiroshi_elder","mood":null,"en":"Exactly. We opened the temples and mountain paths to the children, and raising kids together was natural.","jp":"その通り。お寺も山道も子どもらに開放して、皆で育てるのが当たり前でしたよ。","nonverbal":false,"jpSilence":false,"words":[1,2,4,6,7,8,11,17,19,33,68,117,209,486,514,741,1390,1874,2644,2856,3768,4573,4781,8576,14473,19841],"jpTokens":[{"s":"その","w":33},{"s":"通り","r":"とおり","w":514},{"s":"。"},{"s":"お寺","r":"おてら","w":8576},{"s":"も","w":11},{"s":"山道","r":"さんどう","w":14473},{"s":"も","w":11},{"s":"子ども","r":"こども","w":486},{"s":"ら","w":209},{"s":"に","w":2},{"s":"開放","r":"かいほう","w":3768},{"s":"し","w":19},{"s":"て","w":4},{"s":"、"},{"s":"皆","r":"みな","w":1390},{"s":"で","w":7},{"s":"育てる","r":"そだてる","w":4573},{"s":"の","w":1},{"s":"が","w":6},{"s":"当たり前","r":"あたりまえ","w":1874},{"s":"でし","w":17},{"s":"た","w":8},{"s":"よ","w":68},{"s":"。"}]},{"speaker":"asuka_teacher","mood":null,"en":"Now there are more families with foreign nationalities, and I feel that spirit of acceptance is essential.","jp":"今は外国国籍の家庭も増えていて、そうした受け入れの精神が不可欠だと感じます。","nonverbal":false,"jpSilence":false,"words":[1,3,4,6,9,11,14,18,21,87,271,383,645,681,929,963,985,1455,2114,3076,3874,4099,4781,7562,7885,8024],"jpTokens":[{"s":"今","r":"いま","w":87},{"s":"は","w":3},{"s":"外国","r":"がいこく","w":681},{"s":"国籍","r":"こくせき","w":4099},{"s":"の","w":1},{"s":"家庭","r":"かてい","w":963},{"s":"も","w":11},{"s":"増え","r":"ふえ","w":3076},{"s":"て","w":4},{"s":"い","w":18},{"s":"て","w":4},{"s":"、"},{"s":"そうした","w":1455},{"s":"受け入れ","r":"うけいれ","w":2114},{"s":"の","w":1},{"s":"精神","r":"せいしん","w":645},{"s":"が","w":6},{"s":"不可欠","r":"ふかけつ","w":3874},{"s":"だ","w":21},{"s":"と","w":9},{"s":"感じ","r":"かんじ","w":985},{"s":"ます","w":14},{"s":"。"}]},{"speaker":"hiroshi_elder","mood":null,"en":"No matter the nationality, the mud in the rice paddies is the same. I'd like the newcomers to learn the village history too.","jp":"国籍が違っても、田ん