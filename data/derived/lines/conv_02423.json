{"id":"conv_02423","context":"Asuka lectures on logic, using formal connectives.","ambient":"lecture_hall_quiet","cast":["asuka_teacher","ren_uni"],"tier":4,"lines":[{"speaker":"asuka_teacher","mood":null,"en":"Today we study the basics of argument.","jp":"今日は、議論における基本を学びます。","nonverbal":false,"jpSilence":false,"words":[3,5,14,141,334,413,516,1831,3589,10583],"jpTokens":[{"s":"今日","r":"きょう","w":141},{"s":"は","w":3},{"s":"、"},{"s":"議論","r":"ぎろん","w":516},{"s":"における","w":413},{"s":"基本","r":"きほん","w":334},{"s":"を","w":5},{"s":"学び","r":"まなび","w":1831},{"s":"ます","w":14},{"s":"。"}]},{"speaker":"asuka_teacher","mood":null,"en":"A claim consists of grounds and reasons.","jp":"主張は、根拠及び理由から成り立ちます。","nonverbal":false,"jpSilence":false,"words":[3,14,20,380,565,806,2477,8958,10401,13103],"jpTokens":[{"s":"主張","r":"しゅちょう","w":806},{"s":"は","w":3},{"s":"、"},{"s":"根拠","r":"こんきょ","w":2477},{"s":"及び","r":"および","w":565},{"s":"理由","r":"りゆう","w":380},{"s":"から","w":20},{"s":"成り立ち","r":"なりたち","w":8958},{"s":"ます","w":14},{"s":"。"}]},{"speaker":"ren_uni","mood":null,"en":"What happens if the grounds are weak?","jp":"根拠が弱いと、どうなりますか?","nonverbal":false,"jpSilence":false,"words":[6,9,14,16,47,110,2477,2506,5964,10213],"jpTokens":[{"s":"根拠","r":"こんきょ","w":2477},{"s":"が","w":6},{"s":"弱い","r":"よわい","w":2506},{"s":"と","w":9},{"s":"、"},{"s":"どう","w":110},{"s":"なり","w":47},{"s":"ます","w":14},{"s":"か","w":16},{"s":"?"}]},{"speaker":"asuka_teacher","mood":null,"en":"Counterarguments arise against that claim.","jp":"その主張に対して、反論が出ます。","nonverbal":false,"jpSilence":false,"words":[6,14,33,253,722,806,3753,8506],"jpTokens":[{"s":"その","w":33},{"s":"主張","r":"しゅちょう","w":806},{"s":"に対して","r":"にたいして","w":253},{"s":"、"},{"s":"反論","r":"はんろん","w":3753},{"s":"が","w":6},{"s":"出","r":"で","w":722},{"s":"ます","w":14},{"s":"。"}]},{"speaker":"asuka_teacher","mood":null,"en":"You must support it with facts or experience.","jp":"事実、あるいは経験で、支える必要があります。","nonverbal":false,"jpSilence":false,"words":[6,7,14,22,39,116,254,454,503,4610,9114],"jpTokens":[{"s":"事実","r":"じじつ","w":503},{"s":"、"},{"s":"あるいは","w":254},{"s":"経験","r":"けいけん","w":454},{"s":"で","w":7},{"s":"、"},{"s":"支える","r":"ささえる","w":4610},{"s":"必要","r":"ひつよう","w":116},{"s":"が","w":6},{"s":"あり","w":22},{"s":"ます","w":14},{"s":"。"}]},{"speaker":"ren_uni","mood":null,"en":"How do we combine these?","jp":"これらを、どう組み合わせるんでしょう。","nonverbal":false,"jpSilence":false,"words":[5,17,26,29,93,110,117,517,1228,2280,4395,6529,14255],"jpTokens":[{"s":"これら","w":517},{"s":"を","w":5},{"s":"、"},{"s":"どう","w":110},{"s":"組み合わせる","r":"くみあわせる","w":14255},{"s":"ん","w":26},{"s":"でしょ","w":17},{"s":"う","w":29},{"s":"。"}]},{"speaker":"asuka_teacher","mood":null,"en":"We arrange these elements in good order.","jp":"これらの要素を、順序よく並べます。","nonverbal":false,"jpSilence":false,"words":[1,5,14,517,1309,3837,11941],"jpTokens":[{"s":"これら","w":517},{"s":"の","w":1},{"s":"要素","r":"ようそ","w":1309},{"s":"を","w":5},{"s":"、"},{"s":"順序よく","r":"じゅんじょよく"},{"s":"並べ","r":"ならべ","w":11941},{"s":"ます","w":14},{"s":"。"}]},{"speaker":"asuka_teacher","mood":null,"en":"It's important to present them carefully to the reader.","jp":"読者に対して、丁寧に示すことが大切です。","nonverbal":false,"jpSilence":false,"words":[2,6,15,17,253,676,1370,1697,3156,8506],"jpTokens":[{"s":"読者","r":"どくしゃ","w":1370},{"s":"に対して","r":"にたいして","w":253},{"s":"、"},{"s":"丁寧","r":"ていねい","w":3156},{"s":"に","w":2},{"s":"示す","r":"しめす","w":1697},{"s":"こと","w":15},{"s":"が","w":6},{"s":"大切","r":"たいせつ","w":676},{"s":"です","w":17},{"s":"。"}]},{"speaker":"ren_uni","mood":null,"en":"Does order within the text matter too?","jp":"文章における順序も、関係しますか?","nonverbal":false,"jpSilence":false,"words":[11,14,16,19,143,413,971,3298,3589,5964,7305,10583],"jpTokens":[{"s":"文章","r":"ぶんしょう","w":971},{"s":"における","w":413},{"s":"順序","r":"じゅんじょ","w":7305},{"s":"も","w":11},{"s":"、"},{"s":"関係","r":"かんけい","w":143},{"s":"し","w":19},{"s":"ます","w":14},{"s":"か","w":16},{"s":"?"}]},{"speaker":"asuka_teacher","mood":null,"en":"Yes — logic and structure are inseparable.","jp":"ええ、論理及び構成は、切り離せません。","nonverbal":false,"jpSilence":false,"words":[3,14,26,54,565,969,2023,3039,3590,9856,14584],"jpTokens":[{"s":"ええ","w":3039},{"s":"、"},{"s":"論理","r":"ろんり","w":2023},{"s":"及び","r":"および","w":565},{"s":"構成","r":"こうせい","w":969},{"s":"は","w":3},{"s":"、"},{"s":"切り離せ","r":"きりはなせ"},{"s":"ませ","w":14},{"s":"ん","w":26},{"s":"。"}]},{"speaker":"ren_uni","mood":null,"en":"I understand well. I'll practice.","jp":"よく分かりました。練習してみます。","nonverbal":false,"jpSilence":false,"words":[4,8,14,19,28,178,388,915,1266,1805,3602,4781],"jpTokens":[{"s":"よく","w":178},{"s":"分かり","r":"わかり","w":1805},{"s":"まし","w":14},{"s":"た","w":8},{"s":"。"},{"s":"練習","r":"れんしゅう","w":915},{"s":"し","w":19},{"s":"て","w":4},{"s":"み","w":388},{"s":"ます","w":14},{"s":"。"}]}]}